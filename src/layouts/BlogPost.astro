---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import ArticleDiag from '../components/ArticleDiag.astro';
import MojiRecycler from '../components/MojiRecycler.astro';
import ReadingModeSwitch from '../components/ReadingModeSwitch.astro';
import BaseLayout from './BaseLayout.astro';
import type { PostNeighbors } from '../lib/postNeighbors';
import { alternateMode, modeHref, type ReadingContext } from '../lib/readingMode';

type Props = CollectionEntry<'blog'>['data'] & {
	reading: ReadingContext;
	neighbors: PostNeighbors;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	reading,
	neighbors,
} = Astro.props;

// 副ページ（/emoji/ 側）も canonical は記事の既定モードに向ける。
const canonicalPath = modeHref(reading.slug, reading.defaultMode, reading.defaultMode);
const alternatePath = reading.hasAlternate
	? modeHref(reading.slug, alternateMode(reading.mode), reading.defaultMode)
	: undefined;
---

<BaseLayout
	title={title}
	description={description}
	image={heroImage}
	canonicalPath={canonicalPath}
	alternatePath={alternatePath}
>
	<article>
		<header>
			<hgroup>
				<h1>{title}</h1>
				<p>{description}</p>
			</hgroup>
			<p>
				<FormattedDate date={pubDate} /> · {author}
				{
					updatedDate && (
						<Fragment> · 最終更新 <FormattedDate date={updatedDate} /></Fragment>
					)
				}
			</p>
			{
				reading.hasAlternate && (
					<ReadingModeSwitch
						slug={reading.slug}
						mode={reading.mode}
						defaultMode={reading.defaultMode}
					/>
				)
			}
		</header>
		{
			heroImage && (
				<figure>
					<Image width={1020} height={510} src={heroImage} alt="" />
				</figure>
			)
		}
		<slot />
		{reading.mode === 'emoji' && <MojiRecycler />}
		<ArticleDiag />
		{
			(neighbors.older || neighbors.newer) && (
				<footer>
					{/* 片側が無いときも空の <ul> を残す。pico の nav は space-between なので、
					    残った 1 本が反対側へ寄ってしまうのを防ぐ。 */}
					<nav aria-label="前後の記事">
						<ul>
							{neighbors.older && (
								<li>
									<a href={`/blog/${neighbors.older.id}/`} rel="prev">
										← 前の記事
									</a>
								</li>
							)}
						</ul>
						<ul>
							{neighbors.newer && (
								<li>
									<a href={`/blog/${neighbors.newer.id}/`} rel="next">
										次の記事 →
									</a>
								</li>
							)}
						</ul>
					</nav>
				</footer>
			)
		}
	</article>
</BaseLayout>
